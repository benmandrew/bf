PROJECT_NAME = "bf"
PROJECT_BRIEF = "Brainf*ck to LLVM IR compiler frontend"
OUTPUT_DIRECTORY = @DOXYGEN_OUTPUT_DIR@
INPUT = @DOXYGEN_INPUT_DIR@
FILE_PATTERNS = *.h *.c
RECURSIVE = YES
GENERATE_HTML = NO
GENERATE_XML = YES
EXTRACT_ALL = YES
EXTRACT_STATIC = NO
OPTIMIZE_OUTPUT_FOR_C = YES
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
STRIP_FROM_PATH = @CMAKE_SOURCE_DIR@