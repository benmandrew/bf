FROM nginx:alpine

COPY ./web/index.html /usr/share/nginx/html/index.html
COPY ./web/app.js /usr/share/nginx/html/app.js
COPY ./web/prism.css /usr/share/nginx/html/prism.css
COPY ./web/prism.js /usr/share/nginx/html/prism.js
COPY ./web/favicon.ico /usr/share/nginx/html/favicon.ico
COPY ./web/style.css /usr/share/nginx/html/style.css

# app.js ships with placeholder endpoint URLs (the same the `site` cmake
# target substitutes). The browser reaches the bfc service directly, which
# docker-compose publishes on :8000, so point both fetches there.
ARG BF_COMPILE_URL="http://localhost:8000/compile?code="
ARG BF_CFG_URL="http://localhost:8000/cfg?code="
RUN sed -i \
	-e "s#__BF_COMPILE_URL__#${BF_COMPILE_URL}#g" \
	-e "s#__BF_CFG_URL__#${BF_CFG_URL}#g" \
	/usr/share/nginx/html/app.js
