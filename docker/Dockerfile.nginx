FROM nginx:alpine

# The whole compiler runs in the browser now, so this image just serves the
# static site. The wasm module (web/wasm/) is produced by scripts/build-wasm.sh
# and must exist in the build context; the COPY below fails fast if it does not.
COPY docker/nginx-default.conf /etc/nginx/conf.d/default.conf

COPY web/index.html web/app.js web/worker.js web/highlight.js \
     web/style.css web/prism.css web/prism.js web/favicon.ico \
     /usr/share/nginx/html/
COPY web/vendor/ /usr/share/nginx/html/vendor/
COPY web/wasm/ /usr/share/nginx/html/wasm/
