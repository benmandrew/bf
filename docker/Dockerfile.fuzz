# Pinned, not :latest -- a fuzzing base that moves under you makes crash results
# incomparable across runs. Bump deliberately.
FROM aflplusplus/aflplusplus:v5.02c

# Runs unprivileged, but this image is coupled to the host in a way the others are
# not: fuzz.sh builds into /src, which is the host repo bind-mounted at run time
# (`docker run -ti -v .:/src benmandrew/bf:fuzz`), and crashes land back in the
# host's build-fuzz/. So this uid has to match whoever owns those files on the
# host, or cmake cannot write and the run dies immediately. Default 1000 covers
# the common single-user Linux box and Docker Desktop; override otherwise:
#
#   docker build --build-arg UID=$(id -u) --build-arg GID=$(id -g) \
#       -f docker/Dockerfile.fuzz -t benmandrew/bf:fuzz .
#
# The base is Ubuntu 24.04, which already ships an `ubuntu` account at 1000/1000,
# so an id that is already taken is reused rather than being a build failure.
ARG UID=1000
ARG GID=1000
RUN set -eux; \
    if ! getent group "$GID" >/dev/null; then \
        groupadd --gid "$GID" fuzz; \
    fi; \
    if ! getent passwd "$UID" >/dev/null; then \
        useradd --uid "$UID" --gid "$GID" --no-create-home --shell /usr/sbin/nologin fuzz; \
    fi

WORKDIR /scripts

COPY --chown=$UID:$GID ./verification/fuzz.sh ./

# Numeric, not a name: the account may be the pre-existing `ubuntu` one.
USER $UID:$GID

ENTRYPOINT [ "./fuzz.sh" ]
