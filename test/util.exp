proc expect_exact {text} {
	expect {
		-exact $text {}
		timeout {
			puts "Expected: '$text'"
			exit 1
		}
		eof {
			puts "Program ended too early (wanted '$text')"
			exit 1
		}
	}
}

catch {exec which valgrind} valgrind_path
if {[string length $valgrind_path] > 0} {
    set VALGRIND [list valgrind --leak-check=full --]
} else {
    set VALGRIND ""
}
