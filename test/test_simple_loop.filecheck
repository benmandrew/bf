; RUN: bfc --unoptimised %s.b | FileCheck %s

; Test brainfuck program with a simple loop: +++++[-]
; The [-] pattern is optimised to a single store of zero (CMD_CLEAR).

; CHECK: ; ModuleID = 'main'
; CHECK: source_filename = "main"

; @dp is an alloca inside main, not a global; the tape is private.
; CHECK-NOT: @dp = global
; CHECK: @data = private global [65536 x i8] zeroinitializer

; CHECK: define i32 @main() {
; CHECK: entry:
; CHECK: %dp = alloca i64, align 8
; CHECK: store i64 0, ptr %dp

; Initial addition of 5 to current cell (+++++).
; CHECK: %[[DP1:.*]] = load i64, ptr %dp
; CHECK: %[[PTR1:.*]] = getelementptr inbounds [65536 x i8], ptr @data, i64 0, i64 %[[DP1]]
; CHECK: %[[VAL1:.*]] = load i8, ptr %[[PTR1]], align 1
; CHECK: %[[ADD:.*]] = add i8 %[[VAL1]], 5
; CHECK: store i8 %[[ADD]], ptr %[[PTR1]], align 1

; CMD_CLEAR: [-] collapses to a single store of zero.
; CHECK: %[[DP2:.*]] = load i64, ptr %dp
; CHECK: %[[PTR2:.*]] = getelementptr inbounds [65536 x i8], ptr @data, i64 0, i64 %[[DP2]]
; CHECK: store i8 0, ptr %[[PTR2]], align 1

; Return statement
; CHECK: ret i32 0
; CHECK: }
